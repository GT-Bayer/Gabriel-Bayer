---
import type { Locale } from '../types/portfolio';
import { getDictionary } from '../i18n';
import { site } from '../data/site';
import Arrow from './Arrow.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const { profile: t } = getDictionary(locale);
---
<section class="profile-section section container" id="about" aria-labelledby="profile-title">
  <p class="section-label mono">{t.eyebrow}</p>
  <div class="profile-grid">
    <div><h2 id="profile-title" class="section-title">{t.title}</h2><div class="profile-note"><span class="mono">↳ {t.noteLabel}</span><p>{t.note}</p></div></div>
    <div class="profile-copy"><h3>{t.lead}</h3><p>{t.body}</p><p>{t.second}</p><a class="text-link" href={site.github} target="_blank" rel="noopener noreferrer">{t.link}<Arrow /></a></div>
  </div>
</section>
