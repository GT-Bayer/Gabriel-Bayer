---
interface Props { direction?: 'up-right' | 'right' | 'down'; class?: string }
const { direction = 'up-right', class: className = '' } = Astro.props;
---
<svg class:list={['arrow-icon', className]} width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {direction === 'up-right' ? <path d="M5 19 19 5M5 5h14v14" /> : direction === 'down' ? <path d="M12 3v18M5 14l7 7 7-7" /> : <path d="M3 12h18m-7-7 7 7-7 7" />}
</svg>
